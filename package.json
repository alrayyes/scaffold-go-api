{
  "name": "scaffold-go-api-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, which bunx alone cannot do, and so Prettier, markdownlint and Redocly are pinned like everything else.",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@redocly/cli": "2.46.1",
    "@ribbon-studios/semantic-release-forgejo": "0.1.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9"
  },
  "trustedDependencies": ["lefthook"],
  "scripts": {
    "prepare": "lefthook install",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2",
    "lint:api": "redocly lint",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "release": "semantic-release"
  }
}
